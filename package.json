{
  "name": "@renpwn/bible.js",
  "version": "0.14.11",
  "description": "Node.js library untuk mengakses Bible dengan database SQLite + FTS5. Dilengkapi 12 Versi Bible & 1 Versi Jewish Bible (Hebrew & English), Lexicon beserta artinya, dan audio. Ideal untuk bot WhatsApp/Telegram, aplikasi mobile, dan website Kristiani.",
  "keywords": [
    "bible",
    "alkitab",
    "kristiani",
    "lexicon  ",
    "database",
    "sqlite",
    "fts5",
    "api",
    "nodejs",
    "javascript",
    "hebrew",
    "terjemahan",
    "audio",
    "tanakh",
    "jewish bible"
  ],
  "homepage": "https://github.com/renpwn/bible.js",
  "bugs": {
    "url": "https://github.com/renpwn/bible.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renpwn/bible.js.git"
  },
  "license": "MIT",
  "author": "Ardy Ren <renpwn@proton.me>",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./database": "./setting.db.js",
    "./scraper": "./mt/bible.js"
  },
  "directories": {
    "example": "examples",
    "lib": "mt"
  },
  "scripts": {
    "start": "node index.js",
    "compress:db": "node mt/download.js --compress",
    "extract:db": "node mt/download.js --extract",
    "download:db": "node mt/download.js",
    "scrape:all": "node mt/bible.js -m 1 -B -c 5",
    "migrate:json": "node mt/bible.js -m 4 -B",
    "test": "node examples/test_lib.js",
    "init-db": "node mt/db.js"
  },
  "bin": {
    "bible-scrape": "./mt/bible.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@renpwn/simplelog": "^0.0.2",
    "@renpwn/termux-sqlite3": "^1.0.3",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.1.2",
    "got": "^14.6.6",
    "playwright": "^1.57.0",
    "simplelog": "^0.0.3",
    "tough-cookie": "^6.0.0"
  },
  "optionalDependencies": {
    "puppeteer": "^24.34.0"
  },
  "files": [
    "index.js",
    "setting.db.js",
    "mt/",
    "examples/",
    "README.md",
    "LICENSE"
  ]
}
